<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>NetChat</AssemblyName>
    <RootNamespace>NetChat</RootNamespace>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net472</TargetFramework>
    <AppendTargetFrameworkToOutputPath>False</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <DebugSymbols>False</DebugSymbols>
    <Optimize>True</Optimize>
    <Deterministic>False</Deterministic>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="tContentPatch">
      <HintPath>..\..\..\tContentPatch.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="CommandHelp">
      <HintPath>..\..\..\CommandHelp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Terraria">
      <HintPath>..\..\..\Terraria.exe</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Graphics">
      <HintPath>..\..\SundryTool\Microsoft.Xna.Framework.Graphics.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Game">
      <HintPath>..\..\SundryTool\Microsoft.Xna.Framework.Game.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework">
      <HintPath>..\..\SundryTool\Microsoft.Xna.Framework.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ReLogic">
      <HintPath>..\..\SundryTool\ReLogic.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Core">
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>